# Copy to .env and set your own key locally. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# auto: Gemini with safe local fallback; offline: no Gemini calls; strict: Gemini only
SUPERCHAT_ROUTING_MODE=auto
GEMINI_TIMEOUT_MS=30000
GEMINI_RESPONSE_TIMEOUT_MS=4000
# Set true when served over HTTPS (Render); leave false for localhost HTTP.
COOKIE_SECURE=false
# The launcher reads PORT; Render supplies it automatically.
PORT=8000
